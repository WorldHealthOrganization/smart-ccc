       fhir:Questionnaire.item.linkId [ fhir:value "Ccc.B11S1.DE05-help" ] ;
       fhir:Questionnaire.item.text [ fhir:value "Ask the mother if she has seen blood in the stools at any time during this episode of diarrhoea. Dysentery is diarrhoea with blood in the stool, with or without mucus. The most common cause of dysentery is Shigella bacteria. Dysentery will require specific treatments." ] ;
       fhir:Questionnaire.item.type [ fhir:value "display" ]
