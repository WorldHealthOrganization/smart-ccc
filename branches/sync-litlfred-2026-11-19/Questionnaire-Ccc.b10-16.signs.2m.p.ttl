         fhir:Expression.expression [ fhir:value "(%resource.repeat(item).where(linkId='Cough').answer.first().value = true or %resource.repeat(item).where(linkId='Difficulty Breathing').answer.first().value = true ) and  %resource.repeat(item).where(linkId='Ccc.B10S2.DE04').answer.first().value = false" ]
