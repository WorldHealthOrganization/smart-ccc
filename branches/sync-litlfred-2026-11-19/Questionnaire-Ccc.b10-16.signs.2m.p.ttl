       ], [
         fhir:index 1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-enableWhenExpression" ] ;
         fhir:Extension.valueExpression [
           fhir:Expression.language [ fhir:value "text/fhirpath" ] ;
           fhir:Expression.expression [ fhir:value "%resource.repeat(item).where(linkId='Oxygen_Saturation').repeat(item).where(linkId='Ccc.B10S2.DE09').answer.first().empty()" ]
         ]
       ] ;
       fhir:Questionnaire.item.linkId [ fhir:value "Ccc.B10S2.DE07" ] ;
       fhir:Questionnaire.item.text [ fhir:value "Oxygen Saturation" ] ;
       fhir:Questionnaire.item.type [ fhir:value "quantity" ] ;
       fhir:Questionnaire.item.required [ fhir:value "false"^^xsd:boolean ] ;
       fhir:Questionnaire.item.repeats [ fhir:value "false"^^xsd:boolean ] ;
       fhir:Questionnaire.item.item [
         fhir:index 0 ;
         fhir:Element.extension [
           fhir:index 0 ;
           fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/questionnaire-itemControl" ] ;
           fhir:Extension.valueCodeableConcept [
             fhir:CodeableConcept.coding [
               fhir:index 0 ;
               fhir:Coding.system [ fhir:value "http://hl7.org/fhir/questionnaire-item-control" ] ;
               fhir:Coding.code [ fhir:value "help" ]
             ]
           ]
         ] ;
         fhir:Questionnaire.item.linkId [ fhir:value "Ccc.B10S2.DE07-help" ] ;
         fhir:Questionnaire.item.text [ fhir:value "If pulse oximeter is available, determine oxygen saturation (SpO2). <br />\nAfter turning on, position the appropriate probe based on the child&#8217;s size. If using on a finger or toe, make sure the area is clean and without nail varnish. <b>Ensure that a good (even) pulse signal (waveform) is displayed before taking the reading.</b> If uncertain that the probe is working, check by testing on your own finger. <br />\n<b>Normal oxygen saturation at sea level is 95 &#8211; 100%. Oxygen should be given if saturation drops to less than 90%,</b> and may be needed for children with severe illness if SpO2 less than 94%. Different cut-offs may be used at high altitude." ] ;
         fhir:Questionnaire.item.type [ fhir:value "display" ]
       ]
     ], [
       fhir:index 1 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-enableWhenExpression" ] ;
         fhir:Extension.valueExpression [
