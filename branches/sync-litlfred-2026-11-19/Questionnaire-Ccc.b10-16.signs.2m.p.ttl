         ]
       ] ;
       fhir:Questionnaire.item.linkId [ fhir:value "Ccc.B13S2.DE01-help" ] ;
       fhir:Questionnaire.item.text [ fhir:value "<b>If both tenderness and swelling are present, the child may have mastoiditis, a deep infection in the mastoid bone.</b> Feel behind both ears. Compare them and decide if there is tender swelling of the mastoid bone. In infants, the swelling may be above the ear. Do not confuse this swelling of the bone with swollen lymph nodes." ] ;
       fhir:Questionnaire.item.type [ fhir:value "display" ]
     ]
