         fhir:Questionnaire.item.linkId [ fhir:value "Ccc.B10S2.DE08-help" ] ;
         fhir:Questionnaire.item.text [ fhir:value "Check that the value you have entered is correct. Children with oxygen saturation less than 90% need oxygen if available and urgent referral." ] ;
