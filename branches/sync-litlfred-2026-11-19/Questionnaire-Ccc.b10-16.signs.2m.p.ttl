         fhir:Expression.expression [ fhir:value "%resource.repeat(item).where(linkId='Danger Signs').answer.first().value = false or %resource.repeat(item).where(linkId='Skin Problem').answer.first().value = true" ]
       ]
     ] ;
     fhir:Questionnaire.item.linkId [ fhir:value "Ccc.B14S2.DE12" ] ;
     fhir:Questionnaire.item.text [ fhir:value "Blisters, Sores or Pustules" ] ;
     fhir:Questionnaire.item.type [ fhir:value "boolean" ] ;
     fhir:Questionnaire.item.required [ fhir:value "true"^^xsd:boolean ] ;
     fhir:Questionnaire.item.repeats [ fhir:value "false"^^xsd:boolean ]
  ], [
