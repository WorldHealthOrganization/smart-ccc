         fhir:Coding.code [ fhir:value "Ccc.B14S2.DE08" ] ;
         fhir:Coding.display [ fhir:value "Localised Skin Problem" ]
       ]
     ], [
       fhir:index 2 ;
       fhir:Questionnaire.item.answerOption.valueCoding [
         fhir:Coding.system [ fhir:value "https://smart.who.int/ccc/CodeSystem/Ccc-custom-codes" ] ;
