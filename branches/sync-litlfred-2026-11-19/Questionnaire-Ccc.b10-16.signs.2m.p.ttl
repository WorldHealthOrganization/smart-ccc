             fhir:Coding.system [ fhir:value "http://hl7.org/fhir/questionnaire-item-control" ] ;
             fhir:Coding.code [ fhir:value "help" ]
           ]
         ]
       ] ;
       fhir:Questionnaire.item.linkId [ fhir:value "Ccc.B10S2.DE06-help" ] ;
       fhir:Questionnaire.item.text [ fhir:value "Recurrent wheezing can be a sign of asthma, tuberculosis or other important health problems which require further assessment" ] ;
       fhir:Questionnaire.item.type [ fhir:value "display" ]
