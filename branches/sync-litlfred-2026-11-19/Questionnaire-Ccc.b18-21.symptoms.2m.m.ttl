         ]
       ] ;
       fhir:Questionnaire.item.linkId [ fhir:value "Ccc.B21S1.DE06-help" ] ;
       fhir:Questionnaire.item.text [ fhir:value "Ask the caregiver if the infant is breastfed. This includes both exclusive breastfeeding or receiving breast milk and other foods/fluids." ] ;
       fhir:Questionnaire.item.type [ fhir:value "display" ]
     ]
