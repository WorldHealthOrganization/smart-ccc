     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><pre>map \"https://smart.who.int/ccc/StructureMap/Ccca.registration.p\" = \"Ccca.registration.p\"#xD;\n#xD;\n#xD;\nuses \"http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaireresponse\" alias 'questionnaireResponse' as source#xD;\nuses \"http://hl7.org/fhir/StructureDefinition/Bundle\" alias 'Bundle' as target#xD;\nuses \"https://smart.who.int/ccc/StructureDefinition/patient\" alias 'Patient' as target#xD;\nuses \"https://smart.who.int/ccc/StructureDefinition/relatedperson\" alias 'RelatedPerson' as target#xD;\nuses \"https://smart.who.int/ccc/StructureDefinition/communicationrequest\" alias 'CommunicationRequest' as target#xD;\nuses \"https://smart.who.int/ccc/StructureDefinition/Cccpatient\" alias 'Ccc Patient' as produced#xD;\nuses \"https://smart.who.int/ccc/StructureDefinition/relatedperson\" alias 'RelatedPerson' as produced#xD;\nuses \"https://smart.who.int/ccc/StructureDefinition/communicationrequest\" alias 'CommunicationRequest' as produced#xD;\n#xD;\ngroup bundletrans(source src : questionnaireResponse, target bundle : Bundle) {#xD;\n  src -&gt; bundle.id = uuid() \"id\";#xD;\n  src -&gt; bundle.type = 'batch' \"type\";#xD;\n  src -&gt; bundle.entry as entry then {#xD;\n    src.subject as subject then {#xD;\n      subject.id as idval -&gt;  entry.request as request,  request.method = 'PUT',  request.url = append('/Patient/', idval) \"1153aa45\";#xD;\n    } \"cf5b2513\";#xD;\n    src -&gt; entry.resource = create('Patient') as tgt then {#xD;\n      src -&gt; tgt then Cccpatient(src, tgt) \"77f3ac03\";#xD;\n    } \"75beb242\";#xD;\n  } \"put-Cccpatient\";#xD;\n  src.item first as itm1 where linkId = 'Ccc.A.DE21.1' then {#xD;\n    itm1.item first as item where (linkId = 'relatedpersonid') and answer.exists() then {#xD;\n      src -&gt;  bundle.entry as entry,  entry.request as request,  request.method = 'POST',  entry.resource = create('RelatedPerson') as tgt then {#xD;\n        src -&gt; tgt then relatedperson(src, tgt) \"8f0b9602\";#xD;\n        item.answer first as a then {#xD;\n          a.value as val -&gt; request.url = append('/RelatedPerson/', val) \"78d8bc69\";#xD;\n        } \"eec70023\";#xD;\n      } \"00574b8e\";#xD;\n    } \"74cc3511\";#xD;\n  } \"54daac33\";#xD;\n  src.item first as itm1 where linkId = 'Ccc.A.DE21.1' then {#xD;\n    itm1.item first as item where (linkId = 'Ccc.A.DE38') and answer.exists() then {#xD;\n      src -&gt; bundle.entry as entry then {#xD;\n        src -&gt;  entry.request as request,  request.method = 'POST',  uuid() as uuid,  request.url = append('/CommunicationRequest/', uuid) \"e5343f50\";#xD;\n        src -&gt; entry.resource = create('CommunicationRequest') as tgt then {#xD;\n          src -&gt; tgt then communicationrequestCccade38(src, tgt) \"82d8a873\";#xD;\n        } \"33eeb100\";#xD;\n      } \"d4cd942b\";#xD;\n    } \"5ca7be0f\";#xD;\n  } \"b78fbe33\";#xD;\n}#xD;\n#xD;\ngroup SetOfficalGivenNameCccpatient(source src, target tgt) {#xD;\n  src -&gt; tgt.use = 'official' then {#xD;\n    src.item first as item where (linkId = 'Ccc.A.DE06') and answer.exists() then {#xD;\n      item.answer first as a then {#xD;\n        a.value as val -&gt; tgt.family = val \"77d1bd4f\";#xD;\n      } \"e0827d5d\";#xD;\n    } \"607c4e16\";#xD;\n    src.item first as item where (linkId = 'Ccc.A.DE04') and answer.exists() then {#xD;\n      item.answer first as a then {#xD;\n        a.value as val -&gt; tgt.given = val \"5d3d44f6\";#xD;\n      } \"18edd234\";#xD;\n    } \"e9deb0f3\";#xD;\n    src.item first as item where (linkId = 'Ccc.A.DE05') and answer.exists() then {#xD;\n      item.answer first as a then {#xD;\n        a.value as val -&gt; tgt.given = val \"5d3d44f6\";#xD;\n      } \"18edd234\";#xD;\n    } \"d95279c0\";#xD;\n  } \"ef0f6810\";#xD;\n}#xD;\n#xD;\ngroup MapValueSetExtCodeCccade16(source src, target tgt) {#xD;\n  src -&gt; tgt then {#xD;\n    src -&gt; tgt then {#xD;\n      src where value.code = 'Ccc.A.DE17' -&gt; tgt.gender = 'female' \"368f2e2a\";#xD;\n      src where value.code = 'Ccc.A.DE18' -&gt; tgt.gender = 'male' \"2ae3beca\";#xD;\n      src where value.code = 'Ccc.A.DE19' -&gt; tgt.gender = 'unknown' \"de22e8b7\";#xD;\n    } \"mapbase\";#xD;\n  } \"57676688\";#xD;\n}#xD;\n#xD;\ngroup Cccpatient(source src : questionnaireResponse, target tgt : Patient) {#xD;\n  src.item first as item where (linkId = 'Ccc.A.DE01') and answer.exists() then {#xD;\n    item.answer first as a then {#xD;\n      a.value as val -&gt; tgt.identifier = create('Identifier') as identifier then {#xD;\n        val -&gt;  identifier.value = val,  identifier.use = 'official' \"id\";#xD;\n      } \"aCccade01\";#xD;\n    } \"aCccade01\";#xD;\n  } \"c243b020\";#xD;\n  src.item first as item where (linkId = 'Ccc.A.DE03') and answer.exists() then {#xD;\n    item.answer first as a -&gt;  tgt.extension = create('Extension') as ext,  ext.url = 'https://smart.who.int/ccc/StructureDefinition/anonymous',  ext.value = true \"aCccade03\";#xD;\n  } \"54d12495\";#xD;\n  src.item first as item where (linkId = 'Ccc.A.DE06') or (linkId = 'Ccc.A.DE04') or ((linkId = 'Ccc.A.DE05') and answer.exists()) then {#xD;\n    src -&gt;  tgt as target,  target.name as name then SetOfficalGivenNameCccpatient(src, name) \"30643049\";#xD;\n  } \"7483ae2e\";#xD;\n  src.item first as item where (linkId = 'Ccc.A.DE12') and answer.exists() then {#xD;\n    item.answer first as a then {#xD;\n      a.value as val -&gt;  tgt.extension = create('Extension') as ext,  ext.url = 'https://smart.who.int/ccc/StructureDefinition/birthDateEstimator',  ext.value = val \"aCccade12\";#xD;\n    } \"aCccade12\";#xD;\n  } \"c05cf203\";#xD;\n  src.item first as item where (linkId = 'Ccc.A.DE08') and answer.exists() then {#xD;\n    item.answer first as a then {#xD;\n      a.value as val -&gt; tgt.birthDate = val \"aCccade08\";#xD;\n    } \"aCccade08\";#xD;\n  } \"bded6ae8\";#xD;\n  src.item first as item where (linkId = 'Ccc.A.DE16') and answer.exists() then {#xD;\n    item.answer first as a then MapValueSetExtCodeCccade16(a, tgt) \"225baa79\";#xD;\n  } \"bf4b35f0\";#xD;\n  src.item first as item where (linkId = 'Ccc.A.DE48') and answer.exists() then {#xD;\n    item.answer first as a -&gt;  tgt.extension = create('Extension') as ext,  ext.url = 'https://smart.who.int/ccc/StructureDefinition/primarycaregiver',  ext.value = create('Reference') as ref,  ref.reference = 'relatated-person-id' \"aCccade48\";#xD;\n  } \"04772b09\";#xD;\n  src.item first as itm1 where linkId = 'Ccc.A.DE21.1' then {#xD;\n    itm1.item first as item where (linkId = 'Ccc.A.DE31') and answer.exists() then {#xD;\n      item.answer first as a then {#xD;\n        a.value as val -&gt;  tgt.extension = create('Extension') as ext,  ext.url = 'https://smart.who.int/ccc/Extension/motherVitalStatus',  ext.value = val \"aCccade31\";#xD;\n      } \"aCccade31\";#xD;\n    } \"7f408694\";#xD;\n  } \"39f45e5d\";#xD;\n  src.item first as itm1 where linkId = 'Ccc.A.DE21.1' then {#xD;\n    itm1.item first as item where (linkId = 'Ccc.A.DE32') and answer.exists() then {#xD;\n      item.answer first as a then {#xD;\n        a.value as val -&gt;  tgt.extension = create('Extension') as ext,  ext.url = 'https://smart.who.int/ccc/Extension/fatherVitalStatus',  ext.value = val \"aCccade32\";#xD;\n      } \"aCccade32\";#xD;\n    } \"06ec2524\";#xD;\n  } \"f7424037\";#xD;\n}#xD;\n#xD;\ngroup SetOfficalGivenNamerelatedperson(source src, target tgt) {#xD;\n  src -&gt; tgt.use = 'official' then {#xD;\n    src.item first as itm1 where linkId = 'Ccc.A.DE21.1' then {#xD;\n      itm1.item first as item where (linkId = 'Ccc.A.DE23') and answer.exists() then {#xD;\n        item.answer first as a then {#xD;\n          a.value as val -&gt; tgt.family = val \"77d1bd4f\";#xD;\n        } \"e0827d5d\";#xD;\n      } \"8c426238\";#xD;\n    } \"4cc155ee\";#xD;\n    src.item first as itm1 where linkId = 'Ccc.A.DE21.1' then {#xD;\n      itm1.item first as item where (linkId = 'Ccc.A.DE21') and answer.exists() then {#xD;\n        item.answer first as a then {#xD;\n          a.value as val -&gt; tgt.given = val \"5d3d44f6\";#xD;\n        } \"18edd234\";#xD;\n      } \"ad3fbc15\";#xD;\n    } \"8bc880ed\";#xD;\n    src.item first as itm1 where linkId = 'Ccc.A.DE21.1' then {#xD;\n      itm1.item first as item where (linkId = 'Ccc.A.DE22') and answer.exists() then {#xD;\n        item.answer first as a then {#xD;\n          a.value as val -&gt; tgt.given = val \"5d3d44f6\";#xD;\n        } \"18edd234\";#xD;\n      } \"e9ba83c8\";#xD;\n    } \"17d8d988\";#xD;\n  } \"f41b9847\";#xD;\n}#xD;\n#xD;\ngroup MapValueSetExtCodeCccade24(source src, target tgt) {#xD;\n  src -&gt; tgt then {#xD;\n    src -&gt;  tgt.relationship = create('CodeableConcept') as cc,  cc.coding = create('Coding') as coding then {#xD;\n      src where value.code = 'Ccc.A.DE25' -&gt;  coding.code = 'MTH',  coding.system = 'http://terminology.hl7.org/CodeSystem/v3-RoleCode' \"abd34a78\";#xD;\n      src where value.code = 'Ccc.A.DE26' -&gt;  coding.code = 'FTH',  coding.system = 'http://terminology.hl7.org/CodeSystem/v3-RoleCode' \"b53d1d15\";#xD;\n      src where value.code = 'Ccc.A.DE27' -&gt;  coding.code = 'SIB',  coding.system = 'http://terminology.hl7.org/CodeSystem/v3-RoleCode' \"949ee35f\";#xD;\n      src where value.code = 'Ccc.A.DE28' -&gt;  coding.code = 'EXT',  coding.system = 'http://terminology.hl7.org/CodeSystem/v3-RoleCode' \"7c5a4400\";#xD;\n      src where value.code = 'Ccc.A.DE29' -&gt;  coding.code = 'PRNINLAW',  coding.system = 'http://terminology.hl7.org/CodeSystem/v3-RoleCode' \"544df0cc\";#xD;\n      src where value.code = 'Ccc.A.DE30' -&gt;  coding.code = 'U',  coding.system = 'http://terminology.hl7.org/CodeSystem/v2-0131' \"8c2d96fc\";#xD;\n    } \"4a251df5\";#xD;\n  } \"1b7b6d7a\";#xD;\n}#xD;\n#xD;\ngroup relatedperson(source src : questionnaireResponse, target tgt : RelatedPerson) {#xD;\n  src.item first as item where (linkId = 'Cccrelatedpersoncaregiv