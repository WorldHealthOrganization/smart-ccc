     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/questionnaire-hidden" ] ;
       fhir:Extension.valueBoolean [ fhir:value "true"^^xsd:boolean ]
     ], [
