         fhir:Expression.expression [ fhir:value "%resource.repeat(item).where(linkId='AgeInDays').answer.first().value >1 and  %resource.repeat(item).where(linkId='Ccc.B19S2.DE01').answer.first().value = true and %resource.repeat(item).where(linkId='Ccc.B19S2.DE02').answer.first().value = false and  %resource.repeat(item).where(linkId='AgeInDays').answer.first().value < 21" ]
       ]
     ] ;
     fhir:Questionnaire.item.linkId [ fhir:value "Ccc.B19S2.DE04" ] ;
     fhir:Questionnaire.item.text [ fhir:value "When did the Jaundice first appear?" ] ;
     fhir:Questionnaire.item.type [ fhir:value "choice" ] ;
     fhir:Questionnaire.item.required [ fhir:value "false"^^xsd:boolean ] ;
     fhir:Questionnaire.item.repeats [ fhir:value "false"^^xsd:boolean ] ;
     fhir:Questionnaire.item.answerOption [
       fhir:index 0 ;
       fhir:Questionnaire.item.answerOption.valueCoding [
         fhir:Coding.system [ fhir:value "https://smart.who.int/ccc/CodeSystem/Ccc-custom-codes" ] ;
         fhir:Coding.code [ fhir:value "Ccc.B19S2.DE05" ] ;
         fhir:Coding.display [ fhir:value "Within less than 24 hours of birth" ]
       ]
     ], [
       fhir:index 1 ;
       fhir:Questionnaire.item.answerOption.valueCoding [
         fhir:Coding.system [ fhir:value "https://smart.who.int/ccc/CodeSystem/Ccc-custom-codes" ] ;
         fhir:Coding.code [ fhir:value "Ccc.B19S2.DE06" ] ;
         fhir:Coding.display [ fhir:value "24 hours or more after birth" ]
       ]
     ], [
       fhir:index 2 ;
       fhir:Questionnaire.item.answerOption.valueCoding [
         fhir:Coding.system [ fhir:value "https://smart.who.int/ccc/CodeSystem/Ccc-custom-codes" ] ;
         fhir:Coding.code [ fhir:value "Ccc.B19S2.DE07" ] ;
         fhir:Coding.display [ fhir:value "Unknown when Jaundice first appeared" ]
       ]
     ] ;
     fhir:Questionnaire.item.item [
       fhir:index 0 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/questionnaire-itemControl" ] ;
         fhir:Extension.valueCodeableConcept [
           fhir:CodeableConcept.coding [
             fhir:index 0 ;
             fhir:Coding.system [ fhir:value "http://hl7.org/fhir/questionnaire-item-control" ] ;
             fhir:Coding.code [ fhir:value "help" ]
           ]
         ]
       ] ;
       fhir:Questionnaire.item.linkId [ fhir:value "Ccc.B19S2.DE04-help" ] ;
       fhir:Questionnaire.item.text [ fhir:value "Ask the caregiver when the baby&#8217;s skin first turned yellowish. If the caregiver didn&#8217;t notice the yellow discolouration or can&#8217;t remember when it started, select &#8220;don&#8217;t know&#8221;. <br />\nJaundice that appears in less than 24 hours after birth is always due to an underlying disease. These babies should be referred urgently. <br />\nMany normal babies, particularly small babies, may have jaundice during the first week of life. This jaundice usually appears on the third or fourth day of life and is mild and disappears before the age of two to  three weeks. It does not need any treatment." ] ;
       fhir:Questionnaire.item.type [ fhir:value "display" ]
     ]
  ], [
     fhir:index 19 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/questionnaire-choiceOrientation" ] ;
       fhir:Extension.valueCode [ fhir:value "horizontal" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-enableWhenExpression" ] ;
       fhir:Extension.valueExpression [
         fhir:Expression.language [ fhir:value "text/fhirpath" ] ;
         fhir:Expression.expression [ fhir:value "%resource.repeat(item).where(linkId='Ccc.B20S1.DE01').answer.first().value = true" ]
       ]
     ] ;
     fhir:Questionnaire.item.linkId [ fhir:value "Ccc.B11S2.DE01" ] ;
     fhir:Questionnaire.item.text [ fhir:value "Sunken Eyes" ] ;
     fhir:Questionnaire.item.type [ fhir:value "boolean" ] ;
     fhir:Questionnaire.item.required [ fhir:value "true"^^xsd:boolean ] ;
     fhir:Questionnaire.item.repeats [ fhir:value "false"^^xsd:boolean ] ;
     fhir:Questionnaire.item.item [
       fhir:index 0 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/questionnaire-itemControl" ] ;
         fhir:Extension.valueCodeableConcept [
           fhir:CodeableConcept.coding [
             fhir:index 0 ;
             fhir:Coding.system [ fhir:value "http://hl7.org/fhir/questionnaire-item-control" ] ;
             fhir:Coding.code [ fhir:value "help" ]
           ]
         ]
       ] ;
       fhir:Questionnaire.item.linkId [ fhir:value "Ccc.B11S2.DE01-help" ] ;
       fhir:Questionnaire.item.text [ fhir:value "The eyes of a dehydrated infant may look sunken. In a low-weight infant, the eyes may always look sunken, even if the young infant is not dehydrated. Even though the sign “sunken eyes” is less reliable in a low-weight infant, it can still be used to classify the young infant‘s dehydration. </p>\n\n	<p>Decide if you think the eyes are sunken. Then ask the mother if she thinks her child’s eyes look unusual. Her opinion can help you confirm." ] ;
       fhir:Questionnaire.item.type [ fhir:value "display" ]
     ]
  ], [
     fhir:index 20 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-enableWhenExpression" ] ;
       fhir:Extension.valueExpression [
         fhir:Expression.language [ fhir:value "text/fhirpath" ] ;
         fhir:Expression.expression [ fhir:value "%resource.repeat(item).where(linkId='Ccc.B20S1.DE01').answer.first().value = true" ]
       ]
     ] ;
     fhir:Questionnaire.item.linkId [ fhir:value "Ccc.B11S2.DE02" ] ;
     fhir:Questionnaire.item.text [ fhir:value "Skin pinch of Abdomen" ] ;
     fhir:Questionnaire.item.type [ fhir:value "choice" ] ;
     fhir:Questionnaire.item.required [ fhir:value "true"^^xsd:boolean ] ;
     fhir:Questionnaire.item.repeats [ fhir:value "false"^^xsd:boolean ] ;
     fhir:Questionnaire.item.answerOption [
       fhir:index 0 ;
       fhir:Questionnaire.item.answerOption.valueCoding [
         fhir:Coding.system [ fhir:value "https://smart.who.int/ccc/CodeSystem/Ccc-custom-codes" ] ;
         fhir:Coding.code [ fhir:value "Ccc.B20S2.DE03" ] ;
         fhir:Coding.display [ fhir:value "Skin Pinch goes back very slowly (More than 2 seconds)" ]
       ]
     ], [
       fhir:index 1 ;
       fhir:Questionnaire.item.answerOption.valueCoding [
         fhir:Coding.system [ fhir:value "https://smart.who.int/ccc/CodeSystem/Ccc-custom-codes" ] ;
         fhir:Coding.code [ fhir:value "Ccc.B20S2.DE04" ] ;
         fhir:Coding.display [ fhir:value "Skin Pinch goes back slowly (2 seconds or fewer, but not immediately)" ]
       ]
     ], [
       fhir:index 2 ;
       fhir:Questionnaire.item.answerOption.valueCoding [
         fhir:Coding.system [ fhir:value "https://smart.who.int/ccc/CodeSystem/Ccc-custom-codes" ] ;
         fhir:Coding.code [ fhir:value "Ccc.B20S2.DE05" ] ;
         fhir:Coding.display [ fhir:value "Skin Pinch goes back Normally (immediately)" ]
       ]
     ] ;
     fhir:Questionnaire.item.item [
       fhir:index 0 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/questionnaire-itemControl" ] ;
         fhir:Extension.valueCodeableConcept [
           fhir:CodeableConcept.coding [
             fhir:index 0 ;
             fhir:Coding.system [ fhir:value "http://hl7.org/fhir/questionnaire-item-control" ] ;
             fhir:Coding.code [ fhir:value "help" ]
           ]
         ]
       ] ;
       fhir:Questionnaire.item.linkId [ fhir:value "Ccc.B11S2.DE02-help" ] ;
       fhir:Questionnaire.item.text [ fhir:value "Locate the area on the infant’s abdomen halfway between the umbilicus and the side of the abdomen. To do the skin pinch, use your thumb and first finger. Do not use your fingertips because this will cause pain. Place <br />\nyour hand so that when you pinch the skin, the fold of skin will be in a line up and down the child’s body and not across the child’s <br />\nbody. Firmly pick up all of the layers of skin and the tissue under them. Pinch the skin for <br />\none second and then release it. When you release the skin, look to see if the skin pinch <br />\ngoes back:</p>\n\n	<p>• very slowly (longer than 2 seconds)<br />\n• slowly<br />\n• immediately<br />\nIf the skin stays up for even a brief time after you release it, decide that the skin pinch goes back slowly" ] ;
       fhir:Questionnaire.item.type [ fhir:value "display" ]
     ]
  ], [
     fhir:index 21 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/questionnaire-choiceOrientation" ] ;
       fhir:Extension.valueCode [ fhir:value "horizontal" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-enableWhenExpression" ] ;
       fhir:Extension.valueExpression [
         fhir:Expression.language [ fhir:value "text/fhirpath" ] ;
         fhir:Expression.expression [ fhir:value "%resource.repeat(item).where(linkId='Ccc.B20S1.DE01').answer.first().value = true and %resource.repeat(item).where(linkId='Ccc.B18S2.DE08').answer.first().value.code  = 'Ccc.B18S2.DE11'" ]
       ]
     ] ;
     fhir:Questionnaire.item.linkId [ fhir:value "Ccc.B11S2.DE06" ] ;
     fhir:Questionnaire.item.text [ fhir:value "Restless and Irritable" ] ;
     fhir:Questionnaire.item.type [ fhir:value "boolean" ] ;
     fhir:Questionnaire.item.required [ fhir:value "true"^^xsd:boolean ] ;
     fhir:Questionnaire.item.repeats [ fhir:value "false"^^xsd:boolean ] ;
     fhir:Questionnaire.item.item [
       fhir:index 0 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/questionnaire-itemControl" ] ;
         fhir:Extension.valueCodeableConcept [
           fhir:CodeableConcept.coding [
             fhir:index 0 ;
             fhir:Coding.system [ fhir:value "http://hl7.org/fhir/questionnaire-item-control" ] ;
             fhir:Coding.code [ fhir:value "help" ]
           ]
         ]
       ] ;
       fhir:Questionnaire.item.linkId [ fhir:value "Ccc.B11S2.DE06-help" ] ;
       fhir:Questionnaire.item.text [ fhir:value "Look at the young infant&#8217;s general condition Is the infant restles and irritable? <br />\nAn infant has teh sign &#8220;restless and irritable&#8221; if the infant is restless and irritable all the time or every time he is touched and handled. If an infant is calm when breastfeeding but again <br />\nrestless and irritable when he stops breastfeeding, he has the sign “restless and irritable”. A healthy infant will be consoled when put on the breast." ] ;
       fhir:Questionnaire.item.type [ fhir:value "display" ]
     ]
  ], [
     fhir:index 22 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-enableWhenExpression" ] ;
       fhir:Extension.valueExpression [
         fhir:Expression.language [ fhir:value "text/fhirpath" ] ;
         fhir:Expression.expression [ fhir:value "%resource.repeat(item).where(linkId='zscore').answer.first().exists()" ]
       ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-calculatedExpression" ] ;
       fhir:Extension.valueExpression [
         fhir:Expression.language [ fhir:value "text/fhirpath" ] ;
         fhir:Expression.expression [ fhir:value "iif(%resource.repeat(item).where(linkId='zscore').answer.first().exists(), iif( %resource.repeat(item).where(linkId='zscore').answer.first().value >= (-2.0), 'Normal Weight for Age', iif( %resource.repeat(item).where(linkId='zscore').answer.first().value < (-3.0), 'Very Low Weight for Age','Low Weight for Age')), {})" ]
       ]
     ] ;
     fhir:Questionnaire.item.linkId [ fhir:value "Ccc.B21S2.DE01" ] ;
     fhir:Questionnaire.item.text [ fhir:value "Weight Status" ] ;
     fhir:Questionnaire.item.type [ fhir:value "string" ] ;
     fhir:Questionnaire.item.required [ fhir:value "false"^^xsd:boolean ] ;
     fhir:Questionnaire.item.repeats [ fhir:value "false"^^xsd:boolean ] ;
     fhir:Questionnaire.item.readOnly [ fhir:value "true"^^xsd:boolean ] ;
     fhir:Questionnaire.item.item [
       fhir:index 0 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/questionnaire-itemControl" ] ;
         fhir:Extension.valueCodeableConcept [
           fhir:CodeableConcept.coding [
             fhir:index 0 ;
             fhir:Coding.system [ fhir:value "http://hl7.org/fhir/questionnaire-item-control" ] ;
             fhir:Coding.code [ fhir:value "help" ]
           ]
         ]
       ] ;
       fhir:Questionnaire.item.linkId [ fhir:value "Ccc.B21S2.DE01-help" ] ;
       fhir:Questionnaire.item.text [ fhir:value "Weight status is calculated based on the young infant&#8217;s weight for age Z-score, which is determined from a standardized chart for weight -for-age for the infant&#8217;s sex. <br />\nA young infant is low weight for age if the z-score is below -2. <br />\nA young infant who is less than 7 days old and weighs less than 2 kg is considered very low weight.<br />\nSome young infants who are low weight for age were born with low birth weight. Some did not gain weight well after birth." ] ;
       fhir:Questionnaire.item.type [ fhir:value "display" ]
     ]
  ], [
     fhir:index 23 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-enableWhenExpression" ] ;
       fhir:Extension.valueExpression [
         fhir:Expression.language [ fhir:value "text/fhirpath" ] ;
