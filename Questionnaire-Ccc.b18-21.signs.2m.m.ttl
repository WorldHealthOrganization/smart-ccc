       fhir:Extension.valueExpression [
         fhir:Expression.language [ fhir:value "text/fhirpath" ] ;
         fhir:Expression.expression [ fhir:value "%resource.repeat(item).where(linkId='Ccc.B21S2.DE05').answer.first().value>= 8" ]
       ]
     ] ;
     fhir:Questionnaire.item.linkId [ fhir:value "Ccc.B21S2.DE06" ] ;
     fhir:Questionnaire.item.text [ fhir:value "Sufficient feeds" ] ;
     fhir:Questionnaire.item.type [ fhir:value "integer" ] ;
     fhir:Questionnaire.item.required [ fhir:value "false"^^xsd:boolean ] ;
