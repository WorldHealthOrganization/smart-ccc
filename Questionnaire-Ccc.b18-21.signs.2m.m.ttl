             fhir:Coding.code [ fhir:value "help" ]
           ]
         ]
       ] ;
       fhir:Questionnaire.item.linkId [ fhir:value "Ccc.B21S2.DE09-help" ] ;
       fhir:Questionnaire.item.text [ fhir:value "Ask the mother questions to determine what replacement milk or milks are used. It may be a breastmilk replacement, animal milk or some other fluid or some combination. Determine if this type of replacement feed is appropriate or not appropriate in your setting." ] ;
       fhir:Questionnaire.item.type [ fhir:value "display" ]
     ]
  ], [
