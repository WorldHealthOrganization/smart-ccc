       fhir:Questionnaire.item.linkId [ fhir:value "Ccc.B21S2.DE15-help" ] ;
       fhir:Questionnaire.item.text [ fhir:value "A young infant up to one month of age should be given approximately 60 ml per feed, 8 times per day, and a young infant between 1 and 2 months of age approximately 90 ml at each feed, 7 times per day. It is helpful to have common bottles or cups available so that a mother can show you the amount that she gives." ] ;
       fhir:Questionnaire.item.type [ fhir:value "display" ]
