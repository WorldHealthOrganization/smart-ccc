             fhir:Coding.code [ fhir:value "help" ]
           ]
         ]
       ] ;
       fhir:Questionnaire.item.linkId [ fhir:value "Ccc.B21S2.DE12-help" ] ;
       fhir:Questionnaire.item.text [ fhir:value "A young infant up to one month of age should be fed 8 times and a young infant between 1 <br />\nand 2 months of age should be fed 7 times in 24 hours." ] ;
       fhir:Questionnaire.item.type [ fhir:value "display" ]
     ]
